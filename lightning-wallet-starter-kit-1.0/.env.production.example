# TLS hostname served by the GCE API reverse proxy.
DOMAIN=api.lightingwallet.com
POSTGRES_PASSWORD=replace-with-strong-database-password
REDIS_PASSWORD=replace-with-strong-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
CHAT_JWT_SECRET=replace-with-a-distinct-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
# Format: scrypt$<32 hex salt>$<64 hex digest>; Docker Compose files may escape each delimiter as $$.
ADMIN_PASSWORD_HASH=
# Optional during rollout; set a base32 secret to enforce authenticator codes.
ADMIN_TOTP_SECRET=
# Required for in-console Authenticator enrollment. Exactly 32 bytes as base64 or 64 hex characters.
OPERATOR_MFA_ENCRYPTION_KEY=
VITE_CHAT_API_URL=/api/v1/chat
CORS_ORIGIN=https://lightingwallet.com,https://admin.lightingwallet.com
PUBLIC_ORIGIN=https://lightingwallet.com
CHAT_RELAY_URL=https://lightingwallet.com/api/v1/chat
FLASH_LOAN_PUBLIC_URL=https://lightingwallet.com/flashforge/
FLASH_LOAN_URL=http://flash-loan:32104
FLASH_LOAN_API_URL=http://flash-loan:32104/api
# Set true only after the real external app/API passes integration and security acceptance.
FLASH_LOAN_PROVIDER_APPROVED=false
VITE_WALLETCONNECT_PROJECT_ID=
VITE_ADMIN_URL=https://admin.lightingwallet.com/login
VITE_MAINNET_EXECUTION_ENABLED=false
VITE_MAINNET_MAX_BATCH_COUNT=1000
VITE_ENABLE_MAINNET_SWAP=false
VITE_ENABLE_MAINNET_LAUNCHPAD=false
VITE_ENABLE_MAINNET_BRIDGE=false
LIFI_API_KEY=
ZEROX_API_KEY=
SWAP_PROVIDER_URLS=
GASFREE_PROVIDER_URL=
GASFREE_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RATE_LIMIT_MAX=120
# Dedicated bearer token used only by the metrics collector (32+ random characters).
METRICS_TOKEN=replace-with-a-distinct-random-metrics-token
AUTOMATION_ENABLE_DELIVERY=false
TELEGRAM_BOT_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
WEBHOOK_SIGNING_SECRET=
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_RPC_FALLBACK_URLS=https://rpc.sepolia.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_URLS=https://solana-rpc.publicnode.com,https://solana.drpc.org
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_LAUNCHPAD_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_RPC_FALLBACK_URLS=https://solana-rpc.publicnode.com,https://solana.drpc.org
VITE_SOLANA_NETWORK=mainnet-beta
VITE_EVM_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_EVM_RPC_FALLBACK_URLS=https://eth.llamarpc.com
VITE_TRON_RPC_URL=https://api.trongrid.io
# Only add TRON fallbacks for the exact same network. Never mix Mainnet, Nile and Shasta.
VITE_TRON_RPC_FALLBACK_URLS=
TRON_RPC_URL=https://nile.trongrid.io
# Fallbacks must be on the same TRON network as TRON_RPC_URL.
TRON_RPC_FALLBACK_URLS=
MARKET_DEXSCREENER_URL=https://api.dexscreener.com
MARKET_GECKOTERMINAL_URL=https://api.geckoterminal.com/api/v2
MARKET_HOLDER_PROVIDER_URL=
NODE_ENV=production
