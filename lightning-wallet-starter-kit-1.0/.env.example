NODE_ENV=development
WEB_PORT=4173
API_PORT=3001
VITE_API_URL=http://localhost:3001/api/v1
VITE_APP_SURFACE=
VITE_ADMIN_URL=http://localhost:5173/login
VITE_FLASH_LOAN_URL=http://localhost:32104
DATABASE_URL=postgresql://lightning:lightning_dev@localhost:5432/lightning_wallet
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
CHAT_JWT_SECRET=replace-with-a-distinct-at-least-32-random-characters
VITE_CHAT_API_URL=/api/v1/chat
ADMIN_EMAIL=admin@example.com
# Format: scrypt$<32 hex salt characters>$<64 hex digest characters>
ADMIN_PASSWORD_HASH=
# Optional base32 secret. When set, operator login requires a 6-digit authenticator code.
ADMIN_TOTP_SECRET=
# Optional 32-byte base64 or 64-character hex key. Required for in-console Authenticator enrollment.
OPERATOR_MFA_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:32104
FLASH_LOAN_URL=http://host.docker.internal:32104
FLASH_LOAN_API_URL=http://host.docker.internal:32104
EVM_RPC_URL=https://ethereum-rpc.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TRON_RPC_URL=https://api.trongrid.io
GASFREE_PROVIDER_URL=
GASFREE_API_KEY=
GASFREE_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SWAP_PROVIDER_URL=
SWAP_PROVIDER_URLS=
# Optional. LI.FI works without a key; configure only for higher server-side rate limits.
LIFI_API_KEY=
# Optional secondary EVM quote source. LI.FI remains the default provider.
ZEROX_API_KEY=
SWAP_API_KEY=
MARKET_DEXSCREENER_URL=https://api.dexscreener.com
MARKET_GECKOTERMINAL_URL=https://api.geckoterminal.com/api/v2
# Optional normalized read-only endpoint: { holderCount, topHolders: [{ address, balance, sharePct }] }
MARKET_HOLDER_PROVIDER_URL=
AUTOMATION_ENABLE_DELIVERY=false
TELEGRAM_BOT_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
WEBHOOK_SIGNING_SECRET=
RATE_LIMIT_MAX=120
EVM_RPC_FALLBACK_URLS=https://rpc.sepolia.org,https://ethereum-sepolia-rpc.publicnode.com
SOLANA_RPC_FALLBACK_URLS=https://api.devnet.solana.com
TRON_RPC_FALLBACK_URLS=https://nile.trongrid.io,https://api.shasta.trongrid.io
VITE_WALLETCONNECT_PROJECT_ID=
FINAL_WALLET_ACCEPTANCE_APPROVED=false
FINAL_WALLET_ACCEPTANCE_REPORT=
FINAL_WALLET_ACCEPTANCE_EVIDENCE_SHA256=
WALLET_ACCEPTANCE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
WALLET_ACCEPTANCE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
WALLET_ACCEPTANCE_TRON_NILE_RPC_URL=https://nile.trongrid.io
VITE_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_LAUNCHPAD_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_NETWORK=devnet
VITE_TRON_RPC_URL=https://nile.trongrid.io
# Dedicated testnet RPCs used only by the browser-local signer. Never point these at mainnet.
VITE_LOCAL_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_LOCAL_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_LOCAL_TRON_RPC_URL=https://nile.trongrid.io
# Optional browser-visible read-only portfolio RPCs. Use only public/CORS endpoints; never put a secret API key in a VITE_* value.
VITE_PORTFOLIO_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_PORTFOLIO_ETHEREUM_RPC_FALLBACK_URLS=https://eth.llamarpc.com
VITE_PORTFOLIO_BSC_RPC_URL=https://bsc-rpc.publicnode.com
VITE_PORTFOLIO_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
VITE_PORTFOLIO_BASE_RPC_URL=https://base-rpc.publicnode.com
VITE_PORTFOLIO_ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
VITE_PORTFOLIO_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
VITE_PORTFOLIO_SOLANA_MAINNET_RPC_FALLBACK_URLS=https://solana-rpc.publicnode.com,https://solana.drpc.org
VITE_PORTFOLIO_TRON_SHASTA_RPC_URL=https://api.shasta.trongrid.io
VITE_PORTFOLIO_TRON_MAINNET_RPC_URL=https://api.trongrid.io
# Mainnet execution stays fail-closed until production acceptance is complete.
VITE_MAINNET_EXECUTION_ENABLED=false
VITE_MAINNET_MAX_BATCH_COUNT=1000
VITE_ENABLE_MAINNET_SWAP=false
VITE_ENABLE_MAINNET_LAUNCHPAD=false
VITE_ENABLE_MAINNET_BRIDGE=false
